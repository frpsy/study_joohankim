    "wpWinPosId": 1
  }, {
    "tStartMs": 5104581,
    "dDurationMs": 3099,
    "segs": [ {
      "utf8": "If this is all escaping\nyou, don't worry about it."
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 5107680,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "Phospho MTOR and PS6\nare reduced by fasting."
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 5111790,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "Now, this makes sense."
