    "wpWinPosId": 1
  }, {
    "tStartMs": 2941710,
    "dDurationMs": 1906,
    "segs": [ {
      "utf8": "And because we all need to\nsleep and sleep is seemingly"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 2943616,
    "dDurationMs": 3011,
    "segs": [ {
      "utf8": "important for our health of all kinds."
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 2946627,
    "dDurationMs": 2153,
    "segs": [ {
      "utf8": "You want to prioritize sleep,"
