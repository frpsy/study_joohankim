    "wpWinPosId": 1
  }, {
    "tStartMs": 4583040,
    "dDurationMs": 3088,
    "segs": [ {
      "utf8": "actually has opposite\neffects on blood glucose,"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 4586128,
    "dDurationMs": 2812,
    "segs": [ {
      "utf8": "depending on whether or not\nyou do it early or later in the"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 4588940,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "day."
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 4589890,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "So a fairly recent study looked\nat so-called hit training,"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 4593070,
    "dDurationMs": 1338,
    "segs": [ {
      "utf8": "high intensity interval training,"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 4594408,
    "dDurationMs": 2642,
    "segs": [ {
      "utf8": "which of course can take\nmany different forms."
    } ],
    "wpWinPosId": 1
