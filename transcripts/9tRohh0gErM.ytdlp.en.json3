    "wpWinPosId": 1
  }, {
    "tStartMs": 4476910,
    "dDurationMs": 1739,
    "segs": [ {
      "utf8": "which is glucose clearing."
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 4478649,
    "dDurationMs": 4391,
    "segs": [ {
      "utf8": "You may have heard the old adage\nthat if you take a 20 or 30"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 4483040,
    "dDurationMs": 1297,
    "segs": [ {
      "utf8": "minute walk after dinner,"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 4484337,
    "dDurationMs": 3473,
    "segs": [ {
      "utf8": "that it accelerates the rate\nat which you digest that food."
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 4487810,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "And indeed it does, clearing\nout of glucose from your system"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 4491730,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "can be accomplished through\na number of different means,"
