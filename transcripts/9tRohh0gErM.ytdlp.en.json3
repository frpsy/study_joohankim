  }, {
    "tStartMs": 6994480,
    "dDurationMs": 2679,
    "segs": [ {
      "utf8": "or people will ingest fats only\nuntil their official feeding"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 6997159,
    "dDurationMs": 1811,
    "segs": [ {
      "utf8": "window begins."
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 6998970,
    "dDurationMs": 2112,
    "segs": [ {
      "utf8": "So these are sort of how the\nnegotiations that people carry"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 7001082,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "out tend to go."
