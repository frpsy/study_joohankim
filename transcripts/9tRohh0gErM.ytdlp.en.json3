    "wpWinPosId": 1
  }, {
    "tStartMs": 6945120,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "but that's how sensitive our system is."
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 6947580,
    "dDurationMs": 3122,
    "segs": [ {
      "utf8": "If we already have somewhat\nelevated blood glucose from a"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 6950702,
    "dDurationMs": 2135,
    "segs": [ {
      "utf8": "meal that we ate an hour or so ago,"
