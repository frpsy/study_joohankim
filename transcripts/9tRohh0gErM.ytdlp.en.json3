    "wpWinPosId": 1
  }, {
    "tStartMs": 283180,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "glucose predict mortality, or\nare correlated with mortality,"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 286300,
    "dDurationMs": 1558,
    "segs": [ {
      "utf8": "is true for human beings"
