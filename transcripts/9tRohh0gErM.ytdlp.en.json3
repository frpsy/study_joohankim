    "wpWinPosId": 1
  }, {
    "tStartMs": 2859680,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "or eat dinner with others."
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 2861147,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "Some people eat lunch with\nothers, but in general,"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 2864337,
    "dDurationMs": 2249,
    "segs": [ {
      "utf8": "it's hard to restrict your\nfeeding window to just the"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 2866586,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "absolute middle of the day,"
