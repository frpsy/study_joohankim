  }, {
    "tStartMs": 2789462,
    "dDurationMs": 1868,
    "segs": [ {
      "utf8": "for a period of time."
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 2791330,
    "dDurationMs": 4808,
    "segs": [ {
      "utf8": "So we can view that point\nfrom the perspective of best,"
