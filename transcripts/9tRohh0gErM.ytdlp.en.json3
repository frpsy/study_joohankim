    "wpWinPosId": 1
  }, {
    "tStartMs": 2990943,
    "dDurationMs": 2727,
    "segs": [ {
      "utf8": "a clearing out of the metabolic\ndebris and some of the"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 2993670,
    "dDurationMs": 4389,
    "segs": [ {
      "utf8": "autophagy that's associated\nwith bad processes in the brain."
