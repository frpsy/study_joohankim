    "wpWinPosId": 1
  }, {
    "tStartMs": 275767,
    "dDurationMs": 2863,
    "segs": [ {
      "utf8": "And the reason that they\nincluded \"Lost in Translation\""
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 278630,
    "dDurationMs": 2138,
    "segs": [ {
      "utf8": "in the title is that what I just told you,"
