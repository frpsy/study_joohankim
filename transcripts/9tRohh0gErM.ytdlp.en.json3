    "wpWinPosId": 1
  }, {
    "tStartMs": 1344810,
    "dDurationMs": 2275,
    "segs": [ {
      "utf8": "blood glucose and insulin go down."
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 1347085,
    "dDurationMs": 2785,
    "segs": [ {
      "utf8": "The longer it's been since your last meal,"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 1349870,
    "dDurationMs": 903,
    "segs": [ {
      "utf8": "the lower, typically,"
