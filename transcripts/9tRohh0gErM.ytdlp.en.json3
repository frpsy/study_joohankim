    "wpWinPosId": 1
  }, {
    "tStartMs": 4512066,
    "dDurationMs": 4038,
    "segs": [ {
      "utf8": "it would be five or six hours\nuntil you have transitioned"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 4516104,
    "dDurationMs": 2934,
    "segs": [ {
      "utf8": "from a fed state to a fasted state."
