    "wpWinPosId": 1
  }, {
    "tStartMs": 2998059,
    "dDurationMs": 2281,
    "segs": [ {
      "utf8": "So we could do a whole episode on this,"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 3000340,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "but essentially during\nsleep, and in particular,"
