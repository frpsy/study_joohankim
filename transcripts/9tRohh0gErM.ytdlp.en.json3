    "wpWinPosId": 1
  }, {
    "tStartMs": 2964310,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "in sleep, although that's true\nbecause when we're asleep,"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 2966580,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "typically we're not hungry or\nlooking for food or foraging"
