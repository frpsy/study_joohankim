  }, {
    "tStartMs": 2957810,
    "dDurationMs": 2184,
    "segs": [ {
      "utf8": "you're not actually capitalizing\non the sleep related"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 2959994,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "fasting."
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 2961260,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "Now it's not just the case\nthat it's easiest to fast while"
