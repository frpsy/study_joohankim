    "wpWinPosId": 1
  }, {
    "tStartMs": 2971367,
    "dDurationMs": 1938,
    "segs": [ {
      "utf8": "We're just sleeping."
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 2973305,
    "dDurationMs": 3425,
    "segs": [ {
      "utf8": "There is something special\nabout the fasting that occurs"
