  }, {
    "tStartMs": 4465103,
    "dDurationMs": 2082,
    "segs": [ {
      "utf8": "that's actually what your body\nand your system are paying"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 4467185,
    "dDurationMs": 1615,
    "segs": [ {
      "utf8": "attention to."
