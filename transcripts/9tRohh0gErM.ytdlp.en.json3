    "wpWinPosId": 1
  }, {
    "tStartMs": 7447970,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "or lemon juice in it with\na little pinch of salt."
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 7450000,
    "dDurationMs": 1751,
    "segs": [ {
      "utf8": "I think that little pinch\nof salt is a good idea."
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 7451751,
    "dDurationMs": 2399,
    "segs": [ {
      "utf8": "What is it doing, how is\nit offsetting all this?"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 7454150,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "Well,"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 7455180,
    "dDurationMs": 4115,
    "segs": [ {
      "utf8": "salt water actually has a mild\neffect as a glucose disposal"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 7459295,
    "dDurationMs": 4175,
    "segs": [ {
      "utf8": "agent, but it has a stabilizing\neffect on blood volume."
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 7463470,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "And so,"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 7464400,
    "dDurationMs": 3325,
    "segs": [ {
      "utf8": "because sodium brings with\nit water and the so-called"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 7467725,
    "dDurationMs": 3965,
    "segs": [ {
      "utf8": "osmolarity of your blood in\nyour body depends on the salt"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 7471690,
    "dDurationMs": 3766,
    "segs": [ {
      "utf8": "levels in your blood and brain and body."
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 7475456,
    "dDurationMs": 2624,
    "segs": [ {
      "utf8": "Many people find that\nthey're feeling shaky."
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 7478080,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "They're feeling lightheaded.\nThey can't concentrate."
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 7479830,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "They think they need sugar or food,"
