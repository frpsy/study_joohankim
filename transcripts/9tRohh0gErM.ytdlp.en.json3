    "wpWinPosId": 1
  }, {
    "tStartMs": 7006260,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "as much as carbohydrates will,"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 7007920,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "protein will have sort of\nan intermediate effect."
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 7010230,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "And as I mentioned earlier,"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 7012090,
    "dDurationMs": 3015,
    "segs": [ {
      "utf8": "ingesting carbohydrates with\nsome fat will tend to blunt the"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 7015105,
    "dDurationMs": 3935,
    "segs": [ {
      "utf8": "rise in glucose and will\nextend the duration over which"
