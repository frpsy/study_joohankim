  }, {
    "tStartMs": 7490810,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "they may or may not include\nthe lemon or lime juice."
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 7492530,
    "dDurationMs": 1905,
    "segs": [ {
      "utf8": "They immediately feel better\nand find that it's actually"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 7494435,
    "dDurationMs": 2564,
    "segs": [ {
      "utf8": "quite straightforward to get out to that,"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 7496999,
    "dDurationMs": 3194,
    "segs": [ {
      "utf8": "to wait until the feeding window kicks in."
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 7500193,
    "dDurationMs": 3026,
    "segs": [ {
      "utf8": "This is especially true for\npeople that are using caffeine"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 7503219,
    "dDurationMs": 2011,
    "segs": [ {
      "utf8": "because when you ingest caffeine,"
