    "wpWinPosId": 1
  }, {
    "tStartMs": 4563150,
    "dDurationMs": 2206,
    "segs": [ {
      "utf8": "just taking a light\nwalk can be beneficial."
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 4565356,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "In addition, you could consider\ndoing intense exercise."
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 4570581,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "Now you wouldn't necessarily\nwant to do that immediately"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 4573208,
    "dDurationMs": 982,
    "segs": [ {
      "utf8": "after eating."
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 4574190,
    "dDurationMs": 2736,
    "segs": [ {
      "utf8": "So let's take a look at what\nhigh-intensity training of any"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 4576926,
    "dDurationMs": 3634,
    "segs": [ {
      "utf8": "kind does to blood glucose,\nbecause in this case,"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 4580560,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "it turns out that when you\ndo high intensity training"
