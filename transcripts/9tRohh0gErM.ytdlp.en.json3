    "wpWinPosId": 1
  }, {
    "tStartMs": 7033384,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "unless you just ran an ultra marathon,"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 7035624,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "you're breaking your fast,\nokay, eat a piece of pizza,"
