    "wpWinPosId": 1
  }, {
    "tStartMs": 3030198,
    "dDurationMs": 3872,
    "segs": [ {
      "utf8": "because we want to eat with\nour family and because our"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 3034070,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "family or our significant\nothers eat around eight or"
