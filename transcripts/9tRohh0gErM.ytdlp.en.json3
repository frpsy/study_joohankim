  }, {
    "tStartMs": 7424660,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "or even just a tiny pinch of\nsalt and putting into some"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 7427010,
    "dDurationMs": 2791,
    "segs": [ {
      "utf8": "water and drinking it."
