    "wpWinPosId": 1
  }, {
    "tStartMs": 2924020,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "meaning you don't want your\nfeeding window to be too close"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 2928260,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "to bedtime."
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 2929093,
    "dDurationMs": 2387,
    "segs": [ {
      "utf8": "And that's why we came up\nwith this kind of foundational"
