    "wpWinPosId": 1
  }, {
    "tStartMs": 3014720,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "This is now well-established\nas well as a number of the same"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 3017430,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "processes occurring in\nthe organs of our body."
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 3019900,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "So what we're starting to\nsee here is that there are a"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 3022630,
    "dDurationMs": 2212,
    "segs": [ {
      "utf8": "number of constraints on\nwhen you can eat, now,"
