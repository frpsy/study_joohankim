    "wpWinPosId": 1
  }, {
    "tStartMs": 3036590,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "9:00 PM, and that's the\nonly time we're together,"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 3038360,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "You have to eat late in the day."
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 3040610,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "And that certainly not a sin."
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 3041930,
    "dDurationMs": 1477,
    "segs": [ {
      "utf8": "I'm not saying that's good or bad, here"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 3043407,
    "dDurationMs": 3543,
    "segs": [ {
      "utf8": "we're trying to establish\nif you recall, best, better,"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 3046950,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "and worst."
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 3048080,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "So from both a practical and\na health perspective and a"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 3052340,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "purely objective view of how\nintermittent fasting works and"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 3055507,
    "dDurationMs": 4943,
    "segs": [ {
      "utf8": "can benefit us, starting to eat each day,"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 3060450,
    "dDurationMs": 4065,
    "segs": [ {
      "utf8": "somewhere around 10:00 AM or around noon,"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 3064515,
    "dDurationMs": 4467,
    "segs": [ {
      "utf8": "and then allowing a feeding\nwindow that goes until six or"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 3068982,
    "dDurationMs": 2052,
    "segs": [ {
      "utf8": "maybe 8:00 PM."
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 3071034,
    "dDurationMs": 2122,
    "segs": [ {
      "utf8": "That seems to me,"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 3073156,
    "dDurationMs": 2506,
    "segs": [ {
      "utf8": "at least based on the data\nand what I understand about"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 3075662,
    "dDurationMs": 1458,
    "segs": [ {
      "utf8": "typical cultures,"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 3077120,
    "dDurationMs": 3973,
    "segs": [ {
      "utf8": "where people eat in the\ndaytime and in the evening,"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 3081093,
    "dDurationMs": 3867,
    "segs": [ {
      "utf8": "that seems to me like the kind\nof schedule that will allow"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 3084960,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "you to get the most out\nof intermittent fasting,"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 3087326,
    "dDurationMs": 2106,
    "segs": [ {
      "utf8": "time-restricted feeding,"
