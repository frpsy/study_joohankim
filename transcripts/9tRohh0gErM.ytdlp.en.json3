    "wpWinPosId": 1
  }, {
    "tStartMs": 4494860,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "but light movement or\nexercise does increase gastric"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 4499100,
    "dDurationMs": 1741,
    "segs": [ {
      "utf8": "emptying time, so for instance,"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 4500841,
    "dDurationMs": 4899,
    "segs": [ {
      "utf8": "if you were to eat a meal\nthat ended at 8:00 PM,"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 4505740,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "and then plop to the couch, watch TV,"
