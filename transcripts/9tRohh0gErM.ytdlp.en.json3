    "wpWinPosId": 1
  }, {
    "tStartMs": 4546230,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "literally of doing things like\nair squats and pushups and"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 4548940,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "things like that, and indeed,"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 4550430,
    "dDurationMs": 2569,
    "segs": [ {
      "utf8": "those will increase the expression\nof things like glut four"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 4552999,
    "dDurationMs": 3861,
    "segs": [ {
      "utf8": "and things that mobilize glucose\ninto muscles and things of"
