  }, {
    "tStartMs": 4434075,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "from a fed state to a fasted state."
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 4440400,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "And so I'd like to discuss what those are."
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 4442220,
    "dDurationMs": 3642,
    "segs": [ {
      "utf8": "And I want to emphasize that\nthe term fed state is probably"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 4445862,
    "dDurationMs": 3490,
    "segs": [ {
      "utf8": "a better way to think about\nit than eating or not eating"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 4449352,
    "dDurationMs": 2858,
    "segs": [ {
      "utf8": "because we think of eating\nthe verb, we're eating,"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 4452210,
    "dDurationMs": 1573,
    "segs": [ {
      "utf8": "we're eating, okay, we're\ndone eating I'm fasting now,"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 4453783,
    "dDurationMs": 3909,
    "segs": [ {
      "utf8": "but you're not actually fasting\nyou because you are fed."
