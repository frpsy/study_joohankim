    "wpWinPosId": 1
  }, {
    "tStartMs": 7019040,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "glucose is released."
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 7020410,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "So we really can't say food X\nor beverage X breaks a fast,"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 7026971,
    "dDurationMs": 3134,
    "segs": [ {
      "utf8": "however, at the extremes, we\ncan say that, for instance,"
