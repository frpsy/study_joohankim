    "wpWinPosId": 1
  }, {
    "tStartMs": 7103854,
    "dDurationMs": 2158,
    "segs": [ {
      "utf8": "All of that is great and fine by me."
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 7106012,
    "dDurationMs": 2288,
    "segs": [ {
      "utf8": "Everyone has to establish\nwhat's right for them, today,"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 7108300,
