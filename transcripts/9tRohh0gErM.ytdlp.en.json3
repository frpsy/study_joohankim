    "wpWinPosId": 1
  }, {
    "tStartMs": 7046684,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "fasting for five hours or more."
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 7049150,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "So you can start to see where\nthere's a lot of wiggle room"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 7052070,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "and it's very contextual."
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 7053550,
    "dDurationMs": 2982,
    "segs": [ {
      "utf8": "And this is why any posts that\nyou see or any information"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 7056532,
    "dDurationMs": 2488,
    "segs": [ {
      "utf8": "that you see that something\ndoes or does not break your"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 7059020,
    "dDurationMs": 1213,
    "segs": [ {
      "utf8": "fast,"
    } ],
    "wpWinPosId": 1
  }, {
    "tStartMs": 7060233,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "that doesn't place it in the\ncontext of when the last time"
