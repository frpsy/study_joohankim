rules_version = '2';

// 스터디 홈 공용 DB 규칙 (프로젝트 frpsy-common-db-2026)
// 본인 구글 계정으로 로그인한 사용자가 studyUsers/{본인 uid} 아래 데이터만 읽고 씁니다.
service cloud.firestore {
  match /databases/{database}/documents {

    match /studyUsers/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 그 밖의 모든 경로는 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
